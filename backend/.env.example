# Backend Port
PORT=8080

# Base utilisée quand Node tourne directement sur l’ordinateur.
# Docker expose PostgreSQL sur le port 5433 de la machine hôte.
DATABASE_URL=postgres://user:password@localhost:5433/dashboard

# Better Auth : signe les cookies de session et chiffre les jetons GitHub.
# À remplacer par une longue clé aléatoire personnelle (openssl rand -hex 32).
BETTER_AUTH_SECRET=dummy_better_auth_secret_with_32_characters
# URL publique de l'API (les routes /api/auth/* et le callback GitHub en dépendent).
# En https, les cookies de session sont marqués Secure.
BETTER_AUTH_URL=http://localhost:8080
# Secret optionnel, dérivé en clé AES-256 (aucune longueur exacte imposée).
# Vide : utilise BETTER_AUTH_SECRET. Conserver le secret stable pour relire les données.
ENCRYPTION_KEY=dummy_encryption_key_with_at_least_32_chars

# Origines frontend autorisées à appeler l'API depuis un navigateur
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# GitHub OAuth App (connexion avec GitHub et comptes du service GitHub des widgets).
# URL de callback à déclarer dans l'OAuth App (les deux, GitHub exige une correspondance exacte) :
# <BETTER_AUTH_URL>/api/auth/callback/github et <BETTER_AUTH_URL>/api/auth/callback/github-service
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optionnel : une seconde OAuth App pour le service GitHub (vide : la même que ci-dessus).
GITHUB_SERVICE_CLIENT_ID=
GITHUB_SERVICE_CLIENT_SECRET=

# Envoi des emails (codes de vérification et de réinitialisation) par SMTP.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_USER=votre adresse Gmail, SMTP_PASSWORD=un mot de
# passe d'application (https://myaccount.google.com/apppasswords, validation en deux étapes
# activée). Les emails partent de SMTP_USER, sauf si MAIL_FROM est renseigné.
# SMTP_HOST vide : en développement, les emails (et leurs codes) s'affichent dans la console
# du serveur ; en production (Docker), le serveur refuse de démarrer.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Max sign-in, sign-up and code attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Max requests per IP per 15 minutes, all routes (shared by replicas through Redis)
GLOBAL_RATE_LIMIT_MAX=1000

# The YouTube video player requires no credentials or environment variables.
