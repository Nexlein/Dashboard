{
    // Type-checks sources, tests and scripts only: Node (type stripping) and Vitest run
    // the .ts files directly, in development and in the Docker image alike.
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        // Relative imports name the .ts file, as Node requires when running sources.
        "allowImportingTsExtensions": true,
        // Node's type stripping only removes types: no enums, namespaces or parameter
        // properties, and type-only imports must say so.
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src", "tests", "prisma", "__mocks__", "vitest.config.ts"]
}
