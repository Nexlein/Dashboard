{
    // Type-checks sources, tests and scripts. Node (type stripping) and Vitest run the .ts
    // files directly; tsconfig.build.json compiles src/ to dist/ for production.
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        // Relative imports name the .ts file; the build rewrites them to .js.
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        // Node's type stripping only removes types: no enums, namespaces or parameter
        // properties, and type-only imports must say so.
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src", "tests", "prisma", "__mocks__", "vitest.config.ts"]
}
