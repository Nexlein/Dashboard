generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  displayName   String?
  password      String? // Null for OAuth-only users
  isAdmin       Boolean   @default(false)
  cguAcceptedAt DateTime? // Timestamp when CGU was accepted
  language      String    @default("en") // i18n preference (en/fr)
  theme         String    @default("system") // light/dark/system
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  widgets            WidgetConfig[]
  tokens             OAuthToken[]
  serviceConnections ServiceConnection[]
}

model ServiceConnection {
  id                   Int      @id @default(autoincrement())
  userId               Int
  serviceName          String
  encryptedCredentials Json
  keyHint              String?
  verifiedAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceName])
}

model OAuthToken {
  id           Int       @id @default(autoincrement())
  userId       Int
  provider     String // e.g. "github", "google"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model WidgetConfig {
  id          Int    @id @default(autoincrement())
  userId      Int
  serviceName String
  widgetName  String
  params      Json // Widget params (e.g. { "city": "Paris" })
  refreshRate Int // Refresh interval in seconds
  layout      Json // Grid coords (e.g. { "x": 0, "y": 0, "w": 2, "h": 2 })

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
