{
    "plugins": ["boundaries"],
    "extends": ["plugin:boundaries/recommended"],
    "settings": {
        "boundaries/elements": [
            {
                "type": "frontend",
                "pattern": "frontend/src/**/*"
            },
            {
                "type": "backend",
                "pattern": "backend/**/*"
            },
            {
                "type": "shared",
                "pattern": "shared/**/*"
            }
        ]
    },
    "rules": {
        "boundaries/element-types": [
            2,
            {
                "default": "disallow",
                "rules": [
                    {
                        "from": "frontend",
                        "allow": ["frontend", "shared"]
                    },
                    {
                        "from": "backend",
                        "allow": ["backend", "shared"]
                    },
                    {
                        "from": "shared",
                        "allow": ["shared"]
                    }
                ]
            }
        ]
    },
    "env": {
        "es2024": true,
        "node": true,
        "browser": true
    },
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "ignorePatterns": ["dist", "node_modules", "coverage", "playwright-report"]
}
