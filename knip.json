{
    "ignoreDependencies": ["shadcn", "@fontsource-variable/geist", "tw-animate-css"],
    "ignoreBinaries": ["commitlint", "k6"],
    "ignore": [
        "frontend/src/components/ui/**",
        "backend/tests/k6/**"
    ],
    "ignoreExportsUsedInFile": true,
    "workspaces": {
        "frontend": {
            "project": ["src/**/*.{ts,tsx,js,jsx}"]
        },
        "backend": {
            "project": ["**/*.js"]
        }
    }
}
